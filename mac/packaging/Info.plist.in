<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CMake substitutes the MACOSX_BUNDLE placeholders below from the target
     properties set in mac/CMakeLists.txt. TODO(phase-1): confirm the bundle id
     matches the family's real macOS identifier, and add the Sparkle
     SUFeedURL / SUPublicEDKey keys once Sparkle is provisioned. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>              <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
  <key>CFBundleDisplayName</key>       <string>RabbitEars</string>
  <key>CFBundleExecutable</key>        <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
  <key>CFBundleIconFile</key>          <string>${MACOSX_BUNDLE_ICON_FILE}</string>
  <key>CFBundleIdentifier</key>        <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
  <key>CFBundleShortVersionString</key><string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
  <key>CFBundleVersion</key>           <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
  <key>CFBundlePackageType</key>       <string>APPL</string>
  <!-- Shown in the standard About panel. RabbitEars is GPL-3.0-or-later; the full license
       (LICENSE) + third-party notices (THIRD-PARTY-NOTICES.txt, licenses/) ship in this
       bundle's Resources folder. -->
  <key>NSHumanReadableCopyright</key>  <string>Copyright © 2026 — GPL-3.0-or-later. Full license and third-party notices are in this app's Resources folder.</string>
  <!-- Minimum macOS 26 — deliberate "latest is best" policy (runtime gate only; the
       compile-time deployment target stays unpinned so CI's older SDK still builds). -->
  <key>LSMinimumSystemVersion</key>    <string>26.0</string>
  <key>NSHighResolutionCapable</key>   <true/>
  <key>NSPrincipalClass</key>          <string>NSApplication</string>
  <!-- Sparkle auto-update: the macOS appcast + the shared family Ed25519 public
       key (same string as the Windows WinSparkle build). Ignored when Sparkle
       isn't linked. Live end-to-end update needs a signed/notarized release. -->
  <key>SUFeedURL</key>              <string>https://raw.githubusercontent.com/arcanii/RabbitEars/main/mac/packaging/appcast-mac.xml</string>
  <key>SUPublicEDKey</key>          <string>sKPprIa95Hw+DX3bMoxWMsyC0w9vc4MzEpgx7TBDP1I=</string>
  <key>SUEnableAutomaticChecks</key><true/>
  <!-- The opt-in Spectrum meter observes THIS app's own audio output via a Core Audio
       process tap (macOS 14.2+) to draw a frequency analyser. Only created on an
       explicit user action (enabling the Spectrum meter in Settings ▸ Meters…), which is
       when this consent prompt appears. Playback and the other meters never need it. -->
  <key>NSAudioCaptureUsageDescription</key><string>RabbitEars reads its own audio output to animate the on-screen spectrum meter.</string>
  <!-- App Transport Security: allow cleartext HTTP.

       IPTV is an http:// world. Provider portals, Xtream panels, channel logos, M3U playlists and
       XMLTV guides are overwhelmingly served over plain HTTP on a non-standard port, and the user
       supplies those URLs themselves — there is no fixed set of hosts to whitelist, so a scoped
       NSExceptionDomains list cannot work here.

       Without this, NSURLSession refuses the request before it leaves the process, which is not a
       visible failure: logos silently fall back to a placeholder, an http playlist or guide URL
       just fails to import, and a dead-link probe reports every cleartext channel as unreachable
       while libVLC happily plays those exact URLs through its own socket stack — because libVLC
       does NOT go through NSURLSession and was never subject to ATS. So the practical effect of
       the strict setting was not "no cleartext traffic"; it was "cleartext traffic works for
       playback and silently fails everywhere else".

       We ship notarized outside the App Store, so there is no review gate to satisfy. HTTPS is
       still preferred automatically whenever a provider offers it. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key><true/>
  </dict>
</dict>
</plist>
